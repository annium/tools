<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Xdb</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Xdb</Description>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>xdb</ToolCommandName>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../Xdb.Core/Xdb.Core.csproj" />
        <ProjectReference Include="../Xdb.PostgreSql/Xdb.PostgreSql.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Configuration.Yaml" Version="0.1.0" />
        <PackageReference Include="Annium.Core.Entrypoint" Version="0.1.0" />
        <PackageReference Include="Annium.Core.Runtime.Loader" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Arguments" Version="0.1.0" />
        <PackageReference Include="Annium.linq2db.PostgreSql" Version="0.1.0" />
        <PackageReference Include="Annium.Logging.Console" Version="0.1.0" />
        <PackageReference Include="Annium.Serialization.Yaml" Version="0.1.0" />
    </ItemGroup>
</Project>