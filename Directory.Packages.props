<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- lets the Microsoft.CodeAnalysis.Analyzers pin below apply to the transitive reference -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Annium.AspNetCore.Extensions" Version="1.1.32" />
    <PackageVersion Include="Annium.Configuration.Abstractions" Version="1.1.44" />
    <PackageVersion Include="Annium.Configuration.Yaml" Version="1.1.44" />
    <PackageVersion Include="Annium.Core.Entrypoint" Version="1.1.44" />
    <PackageVersion Include="Annium.Core.Runtime.Loader" Version="1.1.44" />
    <PackageVersion Include="Annium.Data.Models" Version="1.1.44" />
    <PackageVersion Include="Annium.Data.Operations" Version="1.1.44" />
    <PackageVersion Include="Annium.Data.Operations.Serialization.Json" Version="1.1.44" />
    <PackageVersion Include="Annium.Extensions.Arguments" Version="1.1.44" />
    <PackageVersion Include="Annium.Extensions.Jobs" Version="1.1.44" />
    <PackageVersion Include="Annium.Extensions.Shell" Version="1.1.44" />
    <PackageVersion Include="Annium.Infrastructure.Hosting" Version="1.1.32" />
    <PackageVersion Include="Annium.Logging.Console" Version="1.1.44" />
    <PackageVersion Include="Annium.Logging.Microsoft" Version="1.1.44" />
    <PackageVersion Include="Annium.Mesh.Server" Version="1.1.32" />
    <PackageVersion Include="Annium.Net.Http" Version="1.1.44" />
    <PackageVersion Include="Annium.Net.Types.Serialization.Json" Version="1.1.44" />
    <PackageVersion Include="Annium.NodaTime.Serialization.Json" Version="1.1.44" />
    <PackageVersion Include="Annium.Serialization.Json" Version="1.1.44" />
    <PackageVersion Include="Annium.Storage.FileSystem" Version="1.1.32" />
    <PackageVersion Include="Annium.Storage.S3" Version="1.1.32" />
    <PackageVersion Include="Annium.Testing" Version="1.1.44" />
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" />
    <!-- Workspaces 5.9.0 declares a lower bound of 5.9.0-1.26328.17 on this package, a prerelease that was
         never published; pinned to the released 5.9.0 so the resolution is explicit rather than NU1603 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- not referenced by any project: Annium.Analyzers pulls it transitively at 5.0.0, which then
         demands Common/CSharp 5.0.0 and collides with the 5.9.0 line (NU1608). Pinned here so
         transitive pinning lifts it to 5.9.0. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="NSwag.AspNetCore" Version="14.7.1" />
    <PackageVersion Include="Scriban" Version="7.2.6" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
</Project>
