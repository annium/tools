<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Xc</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>Xc</Description>
        <TargetFramework>netcoreapp3.1</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>xc</ToolCommandName>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Configuration.Abstractions" Version="0.1.0" />
        <PackageReference Include="Annium.Core.DependencyInjection" Version="0.1.0" />
        <PackageReference Include="Annium.Core.Entrypoint" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Arguments" Version="0.1.0" />
        <PackageReference Include="Annium.Logging.Console" Version="0.1.0" />
    </ItemGroup>
</Project>