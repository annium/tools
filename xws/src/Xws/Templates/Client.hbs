{{~ for ns in usages ~}}
using {{ ns }};
{{~ end ~}}

namespace {{ namespace }}
{
    public class {{ type }}
    {
        private readonly IClientBase _client;

        public {{ type }}(IClientBase client)
        {
            _client = client;
        }



        {{- for handler in broadcasters }}

        public IObservable<{{ handler.message_type }}> Listen{{ handler.message_name }}()
            => _client.Listen<{{ handler.message_type }}>();

        {{- end }}



        {{- for handler in event_handlers }}

        public void Notify{{ handler.message_name }}({{ handler.message_type }} ev)
            => _client.Notify(ev);

        {{- end }}


        {{- for handler in request_handlers }}

        public Task<IStatusResult<OperationStatus>> {{ handler.request_name }}Async(
            {{ handler.request_type }} request,
            CancellationToken ct = default
        ) => _client.SendAsync(request, ct);
        {{~ if handler.request_type_nullable ~}}

        public Task<IStatusResult<OperationStatus>> {{ handler.request_name }}Async(
            CancellationToken ct = default
        ) => _client.SendAsync(new {{ handler.request_type }}(), ct);
        {{- end -}}

        {{- end }}



        {{- for handler in request_response_handlers }}

        public Task<IStatusResult<OperationStatus, {{ handler.response_type }}>> {{ handler.request_name }}Async(
            {{ handler.request_type }} request,
            CancellationToken ct = default
        ) => _client.FetchAsync<{{ handler.response_type }}>(request, ct);

        public Task<IStatusResult<OperationStatus, {{ handler.response_type }}>> {{ handler.request_name }}Async(
            {{ handler.request_type }} request,
            {{ handler.response_type }} defaultValue,
            CancellationToken ct = default
        ) => _client.FetchAsync<{{ handler.response_type }}>(request, defaultValue, ct);
        {{~ if handler.request_type_nullable ~}}

        public Task<IStatusResult<OperationStatus, {{ handler.response_type }}>> {{ handler.request_name }}Async(
            CancellationToken ct = default
        ) => _client.FetchAsync<{{ handler.response_type }}>(new {{ handler.request_type }}(), ct);

        public Task<IStatusResult<OperationStatus, {{ handler.response_type }}>> {{ handler.request_name }}Async(
            {{ handler.response_type }} defaultValue,
            CancellationToken ct = default
        ) => _client.FetchAsync<{{ handler.response_type }}>(new {{ handler.request_type }}(), defaultValue, ct);
        {{- end -}}

        {{- end }}



        {{- for handler in subscription_handlers }}

        public Task<IStatusResult<OperationStatus, IObservable<{{ handler.message_type }}>>> Subscribe{{ handler.init_name }}Async(
            {{ handler.init_type }} init,
            CancellationToken ct
        ) => _client.SubscribeAsync<{{ handler.init_type }}, {{ handler.message_type }}>(init, ct);
        {{~ if handler.init_type_nullable ~}}

        public Task<IStatusResult<OperationStatus, IObservable<{{ handler.message_type }}>>> Subscribe{{ handler.init_name }}Async(
            CancellationToken ct
        ) => _client.SubscribeAsync<{{ handler.init_type }}, {{ handler.message_type }}>(new {{ handler.init_type }}(), ct);
        {{- end -}}

        {{- end }}
    }
}