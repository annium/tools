<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Solutions>Tools</Solutions>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>xws</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Annium.Core.Entrypoint" />
    <PackageReference Include="Annium.Core.Runtime.Loader" />
    <PackageReference Include="Annium.Extensions.Arguments" />
    <PackageReference Include="Annium.Logging.Console" />
    <PackageReference Include="Annium.Mesh.Server" />
    <PackageReference Include="Annium.Serialization.Json" />
    <PackageReference Include="Scriban" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Templates/**" />
    <EmbeddedResource Remove="Templates/.*" />
  </ItemGroup>
</Project>
