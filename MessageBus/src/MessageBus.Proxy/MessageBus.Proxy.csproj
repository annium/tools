<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>MessageBus.Proxy</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>MessageBus.Proxy</Description>
        <Solutions></Solutions>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);NETSDK1206</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Configuration.CommandLine" Version="0.1.0" />
        <PackageReference Include="Annium.Configuration.Yaml" Version="0.1.0" />
        <PackageReference Include="Annium.Core.Entrypoint" Version="0.1.0" />
        <PackageReference Include="NetMQ" Version="4.0.1.6" />
    </ItemGroup>
</Project>