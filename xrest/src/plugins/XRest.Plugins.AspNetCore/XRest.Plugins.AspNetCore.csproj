<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <PackageId>XRest.Plugins.AspNetCore</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XRest middleware for ASP.NET Core</Description>
        <TargetFramework>netcoreapp3.1</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../XRest.Core/XRest.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="NSwag.AspNetCore" Version="13.6.2" />
    </ItemGroup>
</Project>