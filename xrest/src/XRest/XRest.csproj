<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>XRest</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XRest</Description>
        <TargetFramework>netcoreapp3.1</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>xrest</ToolCommandName>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../XRest.Dotnet/XRest.Dotnet.csproj" />
        <ProjectReference Include="../XRest.TypeScript/XRest.TypeScript.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Core.Entrypoint" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Arguments" Version="0.1.0" />
        <PackageReference Include="Annium.Logging.Console" Version="0.1.0" />
    </ItemGroup>
</Project>