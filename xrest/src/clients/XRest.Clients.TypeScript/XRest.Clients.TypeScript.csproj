<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>XRest.Clients.TypeScript</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>XRest client for TypeScript</Description>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>Library</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>11.0</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../XRest.Clients.Shared/XRest.Clients.Shared.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Data.Operations" Version="0.1.0" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Templates/**" />
        <EmbeddedResource Remove="Templates/.*" />
    </ItemGroup>
</Project>