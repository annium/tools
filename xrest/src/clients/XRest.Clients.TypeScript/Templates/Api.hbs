// imports
import { HttpClient, HttpResponse } from '@annium/client-http'

{{~ if imports.size > 0 ~}}
import {
{{~ for type in imports ~}}
  {{ type.name }},
{{~ end ~}}
} from {{ if area ~}}'../shared'{{~ else ~}}'./shared'{{~ end ~}}
{{~ end ~}}

// exports
{{~ for type in exports ~}}
{{ include 'Templates.BaseType' type }}
{{~ end ~}}

// api
export const {{ name }}Api = (client: HttpClient) => ({
  {{~ for action in actions ~}}
  {{ action.name }}: (
    {{~ for parameter in action.parameters ~}}
    {{ parameter.name }}: {{ parameter.type}},
    {{~ end ~}}
    {{~ if action.has_body ~}}
    body: {{ action.body}},
    {{~ end ~}}
  ): Promise<{{action.response}}> => client
    .{{ action.method }}(
      {{-}}`{{ action.path | string.replace "{" "${" }}`,
      {{-}} { {{~ for parameter in action.query_parameters }} {{ parameter.name }} {{~ if !for.last }}, {{~ end }} {{ end ~}} }
      {{-}} {{~ if action.has_body ~}}, body{{~ end ~}}),
  {{~ end ~}}
})
