<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>xdomains</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>xdomains</Description>
        <TargetFramework>netcoreapp2.2</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Core.DependencyInjection" Version="0.1.0" />
        <PackageReference Include="Annium.Core.Entrypoint" Version="0.1.0" />
        <PackageReference Include="Annium.Extensions.Arguments" Version="0.1.0" />
        <PackageReference Include="Annium.Logging.Console" Version="0.1.0" />
        <PackageReference Include="NodaTime" Version="2.4.6" />
    </ItemGroup>
    <ItemGroup>
        <None Update="zones.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>