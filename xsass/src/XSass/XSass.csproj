<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>XSass</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Description>SassBuilder</Description>
        <TargetFramework>net6.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <DebugType>portable</DebugType>
        <LangVersion>10.0</LangVersion>
        <WarningsAsErrors>true</WarningsAsErrors>
        <IsPackable>true</IsPackable>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Annium.Configuration.Yaml" Version="0.1.0" />
        <PackageReference Include="Annium.Core.DependencyInjection" Version="0.1.0" />
        <PackageReference Include="Annium.Core.Entrypoint" Version="0.1.0" />
        <PackageReference Include="Annium.Core.Runtime" Version="0.1.0" />
        <PackageReference Include="Annium.Logging.Console" Version="0.1.0" />
        <PackageReference Include="LibSassHost" Version="1.3.3" />
        <PackageReference Include="LibSassHost.Native.linux-x64" Version="1.3.3" />
        <PackageReference Include="LibSassHost.Native.osx-x64" Version="1.3.3" />
        <PackageReference Include="LibSassHost.Native.win-x64" Version="1.3.3" />
    </ItemGroup>
    <PropertyGroup>
        <NuspecFile>package.nuspec</NuspecFile>
        <NuspecProperties>publishDir=$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory)/bin/$(Configuration)))</NuspecProperties>
    </PropertyGroup>
</Project>